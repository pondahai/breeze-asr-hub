# Copy to .env and edit. Every value here is optional: with the file absent the
# defaults in breeze_hub/config.py apply, and anything hardware-specific is
# filled in from hardware.json by scripts/probe_hardware.sh.
#
# Precedence: process environment > .env > hardware.json > built-in default.

# --- Network ----------------------------------------------------------------
HOST=0.0.0.0
BATCH_PORT=8014
REALTIME_HTTP_PORT=8015
REALTIME_WS_PORT=8016

# --- Engine and model -------------------------------------------------------
# Relative paths resolve against the repository root.
# WHISPER_CLI=engine/whisper.cpp/build/bin/whisper-cli
ASR_LANGUAGE=zh
# ASR_THREADS defaults to the probed core count.
# ASR_THREADS=6

# Two upstream Breeze models exist, tuned for different speech:
#
#   25  Taiwanese Mandarin, plus Mandarin-English code-switching
#   26  Taiwanese Hokkien (Taigi), transcribed as Chinese characters
#
# Convert whichever you need -- both can coexist, and callers pick per request
# (`model=26` on /api/transcribe, POST /api/model on the realtime console):
#
#   scripts/fetch_model.sh --convert --variant 25
#   scripts/fetch_model.sh --convert --variant 26
#
# MODEL_VARIANT is only the fallback for callers that do not ask for one.
# 26 matches what the reference deployment has always run. Set it to 25 if most
# of your audio is Mandarin: on a Mandarin meeting recording 26 opened with a
# hallucinated caption and dropped the chairman's entire opening remarks, which
# 25 transcribed correctly.
MODEL_VARIANT=26
# MODEL_DIR=models

# Pins the default variant to one specific file, e.g. a model kept on another
# disk. Named variants always resolve through MODEL_DIR regardless, so setting
# this never makes the other model unreachable.
# MODEL_PATH=models/ggml-breeze-asr-25.bin

# Leave MODEL_URL empty unless you host the model yourself; see
# scripts/fetch_model.sh for how to supply a local copy instead.
MODEL_URL=
MODEL_SHA256=

# Source checkpoint for `scripts/fetch_model.sh --convert` when --variant is not
# given. Ignored by the services at runtime. Any Whisper-architecture repo
# works, e.g. openai/whisper-small for a smoke test.
# MODEL_HF_REPO=MediaTek-Research/Breeze-ASR-25
MODEL_HF_REVISION=main

# --- Microphone -------------------------------------------------------------
# MIC_DEVICE empty = auto-detect at startup, preferring a PCM whose name
# contains MIC_KEYWORD, then any non-onboard card, then "default".
MIC_DEVICE=
MIC_KEYWORD=C525
SAMPLE_RATE=16000

# --- VAD --------------------------------------------------------------------
# Raw int16 RMS (0-32767), the same number the console's meter shows.
# Do not copy this between machines -- run `python3 -m breeze_hub.calibrate`.
VAD_NOISE_THRESHOLD=1200
VAD_SILENCE_DURATION_SEC=0.6
VAD_MIN_SPEECH_SEC=0.8
VAD_MAX_SPEECH_SEC=10.0

# --- Camera (realtime console preview) --------------------------------------
CAMERA_ENABLED=1
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=360

# --- Optional downstream services -------------------------------------------
# Both are probed at runtime; when unreachable the UI degrades instead of
# erroring. WhisperX adds speaker diarization, the LLM adds summarisation.
WHISPERX_API_URL=http://127.0.0.1:8088
LLM_API_URL=http://127.0.0.1:18082
LLM_MODEL_NAME=
# Used by WhisperX for gated diarization weights, and by --convert if the
# source checkpoint is gated or private.
HF_TOKEN=

# --- Storage ----------------------------------------------------------------
UPLOAD_DIR=var/uploads
RESULT_DIR=var/results
LOG_DIR=var/logs
WORK_DIR=var/tmp
HISTORY_PATH=var/history.jsonl
HISTORY_MAX_BYTES=5242880
HISTORY_KEEP=3
AUDIO_ENABLED=true
# Point this at the roomy disk. On the Jetson that is the SD card.
AUDIO_DIR=var/audio
